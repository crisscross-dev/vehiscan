# Environment and Configuration — catch ALL .env variants
.env
.env.*
!.env.example

# Sensitive Files
config.php.backup
*.key
*.pem

# Logs
*.log
logs/
error.log
access.log

# Uploads and User Data
uploads/*
!uploads/.gitkeep
qr_codes/*
!qr_codes/.gitkeep

# Cache
cache/
*.cache

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary Files
tmp/
temp/
*.tmp
tmpclaude-*

# Archive (dead code / diagnostic scripts - not for public repo)
_archive/

# Archived diagnostics moved out of public root
diagnostics_archived/

# Scratch / local diagnostic scripts
scratch/

# Backup Files
*.backup
*.bak
*.old
*~

# Database Dumps
*.sql.gz
*.sql.zip
database_backups/
admin/backups_db/
backups/*.json
backups/

# Node Modules (if any)
node_modules/
package-lock.json

# Vendor (if using Composer)
vendor/

# System Files
.htaccess.backup
.htaccess.production
*.orig

# Diagnostic Files
system_diagnostic.php
phpinfo.php
test*.php
debug*.php

# Temporary PowerShell / shell scripts
*.ps1

# Sensitive exports, cookies, and diagnostics
cookiejar.txt
cookies*.txt
*headers*.txt
*.body
*.body.bak
*_body.html
*.resp.txt
# Error document handlers
ErrorDocument 404 error_pages/404.php
ErrorDocument 403 error_pages/403.php
ErrorDocument 500 error_pages/500.php

# Disable directory listing
Options -Indexes

# Protect sensitive dotfiles (.env, .git, etc.)
<FilesMatch "^\.(env|git|htaccess|htpasswd)">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

<IfModule mod_headers.c>
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>

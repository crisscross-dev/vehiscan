# Error document handlers
ErrorDocument 404 error_pages/404.php
ErrorDocument 403 error_pages/403.php
ErrorDocument 500 error_pages/500.php

# Disable directory listing
Options -Indexes
RewriteEngine On

# Protect sensitive dotfiles (.env, .git, etc.)
<FilesMatch "^\.(env|git|htaccess|htpasswd)">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Block direct access to root-level diagnostics, backups, and response captures.
RewriteRule ^(?:backups|diagnostics|scratch|_archive|public_html)(?:/|$) - [F,L]
RewriteRule ^(?:.*\.(?:body|bak|log|json|ps1|sql)|admin_.*|auth_.*|dash_.*|login_.*|cookie.*|csp_.*|qr_.*|rfid_.*|smoke_.*|verify_.*|unauth_.*|authenticated_.*|create_.*|delete_.*|test_.*|temp_.*|hp_.*|post_.*|visitors_.*|dashboard_.*|visitor_.*|admin_panel_.*|README(?:\.[A-Za-z0-9]+)?|readme(?:\.[A-Za-z0-9]+)?|SECURITY_AUDIT_REPORT(?:\.[A-Za-z0-9]+)?|SYSTEM_AUDIT_REPORT(?:\.[A-Za-z0-9]+)?|CODERABBIT_ANALYSIS(?:\.[A-Za-z0-9]+)?)$ - [F,L,NC]

<IfModule mod_headers.c>
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>
